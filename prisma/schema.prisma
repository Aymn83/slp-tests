// منصة الاختبارات الخاصة باضطرابات اللغة والكلام
// PostgreSQL محلياً وعلى السيرفر.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String?
  passwordHash String
  fullName     String
  fullNameEn   String?
  organization String? // جهة العمل — تظهر في ترويسة التقرير
  jobTitle     String?
  phone        String?
  role         String    @default("examiner") // admin | examiner | student
  status       String    @default("pending") // pending | active | suspended | rejected
  packageId    String?
  package      Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  expiresAt    DateTime? // انتهاء العضوية (اختياري)
  lastLoginAt  DateTime?
  photo        Bytes? // الصورة الشخصية (تظهر في بطاقة المستخدم)
  hasPhoto     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  specialists Specialist[] // صفحته في دليل الاختصاصيين — صفحة واحدة لكل حساب (يُفرض في الكود)
  cases       Case[]
  assessments Assessment[]
  attempts    ActivityAttempt[]
  resetTokens PasswordResetToken[]
}

// رابط «نسيت كلمة المرور»: يُخزَّن بصمة الرمز فقط (لا الرمز نفسه)، ويُستخدم مرة واحدة خلال ساعة
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// محاولة طالب في نشاط تدريبي — تُصحَّح الإجابات في الخادم ولا تُرسل مفاتيحها للمتصفح
model ActivityAttempt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  answers     String    @default("{}") // JSON: { رقم السؤال: الخيار المختار } — أول إجابة لكل سؤال نهائية
  score       Int?
  total       Int
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([activityId])
}

// الباقة: مجموعة اختبارات يُسمح لأعضائها باستخدامها
model Package {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  description String?
  testIds     String   @default("[]") // JSON: مصفوفة معرّفات الاختبارات
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

// دليل الاختصاصيين المعتمدين — صفحة عامة؛ يظهر الاختصاصي فيها بعد موافقة المدير
model Specialist {
  id            String    @id @default(cuid())
  userId        String? // الحساب المالك — يستطيع تعديل صفحته بنفسه
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName      String
  phone         String?
  email         String?
  specialty     String
  licenseNumber String
  country       String
  governorate   String?
  workplace     String?
  workPhone     String?
  skills        String? // المهارات والخبرات — نص حر يكتبه الاختصاصي
  photo         Bytes? // صورة مصغّرة (JPEG) — تُضمَّن في النسخ الاحتياطي مع القاعدة
  hasPhoto      Boolean   @default(false) // لتجنّب تحميل الصور عند عرض القوائم
  status        String    @default("pending") // pending | approved | rejected
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

// المفحوص — يملكه الفاحص الذي أدخله فقط
model Case {
  id               String    @id @default(cuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fullName         String
  birthDate        DateTime?
  gender           String? // male | female
  referralSource   String?
  referralReason   String?
  initialDiagnosis String?
  motherLanguage   String?
  homeLanguages    String?
  school           String?
  grade            String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assessments Assessment[]

  @@index([ownerId])
}

// تطبيق اختبار على مفحوص
model Assessment {
  id              Int      @id @default(autoincrement()) // يُشتق منه رقم التقرير
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  examinerId      String
  examiner        User     @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  testId          String
  testVersion     String
  testDate        DateTime @default(now())
  responses       String   @default("{}") // JSON: { itemId: value }
  extra           String   @default("{}") // JSON: حقول نصية إضافية يعرّفها الاختبار
  recommendations String   @default("")
  notes           String   @default("")
  status          String   @default("draft") // draft | final
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([examinerId])
  @@index([caseId])
}
