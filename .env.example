# ===== نموذج متغيّرات البيئة — انسخه إلى .env على السيرفر واملأ القيم =====

# قاعدة البيانات (PostgreSQL) — مستخدم وقاعدة مخصّصان للموقع، معزولان عن براعم
DATABASE_URL="postgresql://slp_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/slp_tests?schema=public"

# سر توقيع الجلسات — ولّده بالأمر: openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_64_HEX_CHARS"

# حساب المدير الأول (يُنشأ مرة واحدة عند تشغيل npm run db:seed) — غيّر كلمة المرور بعد أول دخول
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

NODE_ENV=production
PORT=3200

# ===== البريد (لرسائل «نسيت كلمة المرور») — بريد Hostinger =====
# كلمة المرور هي كلمة مرور صندوق البريد نفسه من لوحة Hostinger
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="noreply@therapists-slp.com"
SMTP_PASS="CHANGE_ME_MAILBOX_PASSWORD"
MAIL_FROM="الاختبارات الخاصة باضطرابات اللغة والكلام <noreply@therapists-slp.com>"
